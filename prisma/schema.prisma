// Prisma Schema for Schulbibliothek (School Library System)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  LIBRARIAN
  STUDENT
}

enum BookStatus {
  AVAILABLE
  LOANED
  RESERVED
  LOST
}

enum LoanStatus {
  ACTIVE
  RETURNED
  OVERDUE
}

model User {
  id           String    @id @default(cuid())
  role         UserRole  @default(STUDENT)
  firstName    String
  lastName     String
  email        String    @unique
  passwordHash String
  schoolClass  String?
  externalId   String?   @unique // For future IServ integration
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  loans Loan[]

  @@index([role])
  @@index([lastName, firstName])
}

model Book {
  id            String     @id @default(cuid())
  isbn          String?
  title         String
  author        String
  publisher     String?
  coverUrl      String?
  description   String?
  inventoryCode String     @unique // Internal library barcode
  status        BookStatus @default(AVAILABLE)
  location      String?    // Shelf/location info
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  loans Loan[]

  @@index([isbn])
  @@index([status])
  @@index([title])
  @@index([author])
}

model Loan {
  id           String     @id @default(cuid())
  bookId       String
  userId       String
  loanedAt     DateTime   @default(now())
  dueDate      DateTime
  returnedAt   DateTime?
  renewalCount Int        @default(0)
  status       LoanStatus @default(ACTIVE)

  book Book @relation(fields: [bookId], references: [id], onDelete: Restrict)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([bookId])
  @@index([userId])
  @@index([status])
  @@index([dueDate])
  @@index([bookId, status]) // For checking active loans on a book
}

model Settings {
  id              String   @id @default("singleton")
  defaultLoanDays Int      @default(21)
  maxRenewals     Int      @default(2)
  updatedAt       DateTime @updatedAt
}
